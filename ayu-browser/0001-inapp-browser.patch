+	borderActive: 1px;
+}
+ayuBrowserErrorLabel: FlatLabel(defaultFlatLabel) {
+	textFg: boxTitleFg;
+}
+
+// Compact chat top bar button that opens the in-app browser.
+ayuBrowserTopBar: IconButton {
+	width: 40px;
+	height: topBarHeight;
+
+	icon: icon {{ "menu/link", menuIconFg }};
+	iconOver: icon {{ "menu/link", menuIconFgOver }};
+	iconPosition: point(8px, 8px);
+
+	rippleAreaPosition: point(4px, 4px);
+	rippleAreaSize: 32px;
+	ripple: defaultRippleAnimationBgOver;
+}
