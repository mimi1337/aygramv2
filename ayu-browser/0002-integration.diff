 ayuServiceTimeBadgeLastLineWidthAdd: 9px;
+
+// AyuGram in-app browser (see ayu/features/browser/)
+ayuBrowserBack: IconButton(defaultIconButton) {
+	width: 32px;
+	height: 32px;
+
+	icon: icon {{ "box_button_back", menuIconColor }};
+	iconOver: icon {{ "box_button_back", menuIconFg }};
+	iconPosition: point(4px, 4px);
+	rippleAreaPosition: point(0px, 0px);
+	rippleAreaSize: 32px;
+	ripple: defaultRippleAnimationBgOver;
+}
+ayuBrowserForward: IconButton(ayuBrowserBack) {
+	icon: icon {{ "box_button_back-flip_horizontal", menuIconColor }};
+	iconOver: icon {{ "box_button_back-flip_horizontal", menuIconFg }};
+}
+ayuBrowserReload: IconButton(ayuBrowserBack) {
+	icon: icon {{ "settings/reload", menuIconColor }};
+	iconOver: icon {{ "settings/reload", menuIconFg }};
+}
+ayuBrowserClose: IconButton(ayuBrowserBack) {
+	icon: icon {{ "simple_close", menuIconColor }};
+	iconOver: icon {{ "simple_close", menuIconFg }};
+}
+ayuBrowserAddress: InputField(defaultInputField) {
+	heightMin: 32px;
+	heightMax: 32px;
+	textMargins: margins(10px, 0px, 10px, 0px);
+	placeholderMargins: margins(10px, 0px, 10px, 0px);
+	placeholderShift: 0px;
+	borderRadius: 8px;
+	border: 1px;
+	borderActive: 1px;
+}
+ayuBrowserErrorLabel: FlatLabel(defaultFlatLabel) {
+	textFg: boxTitleFg;
+}
+
+// Compact chat top bar button that opens the in-app browser.
+ayuBrowserTopBar: IconButton {
+	width: 40px;
+	height: topBarHeight;
+
+	icon: icon {{ "menu/link", menuIconFg }};
+	iconOver: icon {{ "menu/link", menuIconFgOver }};
+	iconPosition: point(8px, 8px);
+
+	rippleAreaPosition: point(4px, 4px);
+	rippleAreaSize: 32px;
+	ripple: defaultRippleAnimationBgOver;
+}
